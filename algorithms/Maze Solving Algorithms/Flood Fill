#include <stdio.h>

#define N 5

int Map[N][N];

int QueueX[100];
int QueueY[100];

int Dx[4] = {-1, 1, 0, 0};
int Dy[4] = {0, 0, -1, 1};

void FloodFill(int GoalX, int GoalY)
{
    int Front = 0;
    int Rear = 0;

    for (int i = 0; i < N; i++)
    {
        for (int j = 0; j < N; j++)
        {
            Map[i][j] = -1;
        }
    }

    Map[GoalX][GoalY] = 0;

    QueueX[Rear] = GoalX;
    QueueY[Rear] = GoalY;
    Rear++;

    while (Front < Rear)
    {
        int X = QueueX[Front];
        int Y = QueueY[Front];
        Front++;

        for (int d = 0; d < 4; d++)
        {
            int NewX = X + Dx[d];
            int NewY = Y + Dy[d];

            if (NewX < 0 || NewX >= N ||
                NewY < 0 || NewY >= N)
            {
                continue;
            }

            if (Map[NewX][NewY] == -1)
            {
                Map[NewX][NewY] = Map[X][Y] + 1;

                QueueX[Rear] = NewX;
                QueueY[Rear] = NewY;
                Rear++;
            }
        }
    }
}

int main()
{
    FloodFill(2, 2);

    for (int i = 0; i < N; i++)
    {
        for (int j = 0; j < N; j++)
        {
            printf("%3d", Map[i][j]);
        }

        printf("\n");
    }

    return 0;
}
